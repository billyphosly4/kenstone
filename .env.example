DATABASE_URL="postgresql://postgres.fckqcnagekzhlvbmfgad:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Supabase shared session-mode pooler for Prisma migrations; replace the placeholder locally.
DIRECT_URL="postgresql://postgres.fckqcnagekzhlvbmfgad:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"
PORT=3000
CORS_ORIGINS="http://localhost:5173"
# Set to the exact number of trusted reverse-proxy hops; keep 0 when directly exposed.
TRUST_PROXY_HOPS=0
# Leave empty to use the Vite development proxy, or set the deployed API origin.
